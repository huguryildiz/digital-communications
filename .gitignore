# Third-party and oversized source material. Never redistributed, never in history.
source/

# Generated intermediates and derived editions. Only the artifact and the lecture
# notes PDF are tracked; the other three editions are rebuilt from the sources.
dist/Lecture_Notes.html
dist/Student_Workbook.*
dist/Instructor_Solutions.*
dist/Formula_Reference.*

# Local working area. The agent instructions and guards are tracked; commands,
# plans, specs, reports, notes, and other working records remain ignored.
.claude/*
!.claude/README.md
!.claude/settings.json
!.claude/rules/
!.claude/hooks/
.claude/hooks/__pycache__/
.claude/worktrees/

# Local toolchain and scratch output.
.venv/
node_modules/
shots/
shots-m/
pages/
textclash.json
__pycache__/
.pytest_cache/

.DS_Store
.vercel

# Working notes for the agents that build this, not part of what is published.
.Codex/notes/

# The root instruction files are tracked; ignore copies anywhere else.
CLAUDE.md
AGENTS.md
DESIGN.md
PRODUCT.md
!/CLAUDE.md
!/AGENTS.md
!/DESIGN.md
!/PRODUCT.md

# The Python runtime for the code pages, staged by tools/pyodide.js at deploy.
dist/pyodide/
tools/.cache/
