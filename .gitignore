# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Node ---
node_modules/

# --- Restricted source material (kept on disk, never tracked) ---
# The whole directory, not file by file, so a new subdirectory cannot slip in.
# It holds the lecture material and a textbook, which are never reproduced or
# redistributed. A fresh clone will not contain any of it.
source/

# --- Pipeline output that is not a deliverable ---
# notes/build.js and notes/editions.js write these so notes/topdf.js can turn them
# into PDFs. They are intermediates, regenerated by one command each.
dist/Lecture_Notes.html
dist/Student_Workbook.html
dist/Instructor_Solutions.html
dist/Formula_Reference.html
dist/Laboratory_Sheets.html
# The lecture notes, student workbook, formula reference and laboratory sheets
# PDFs are published deliverables and stay tracked. The instructor PDF remains a local build product
# and is never published.
dist/Instructor_Solutions.pdf
# build/qa.js screenshot dump and build/textclash.js report.
shots/
shots-m/
textclash.json
# pdftoppm renders of the source pages, made for the visual audit.
pages/

# --- Scratch ---
*.tmp
*.log

# Local working area. The agent instructions and guards are tracked; prompts,
# plans, reports, audits, references, and other working records remain ignored.
.claude/*
!.claude/README.md
!.claude/settings.json
!.claude/rules/
!.claude/hooks/
.claude/hooks/__pycache__/
.claude/worktrees/

# Working notes for the agents that build this, not part of what is published.
.codex/notes/

# The root instruction files are tracked; ignore copies anywhere else.
CLAUDE.md
AGENTS.md
DESIGN.md
PRODUCT.md
!/CLAUDE.md
!/AGENTS.md
!/DESIGN.md
!/PRODUCT.md

# Editor settings: a local convenience, not a property of the project.
.vscode/

# --- Public site build (web/build-site.js) ---
# Assembled from dist/ on every deploy; nothing in it is authored by hand.
site/
.vercel
# web/pyodide.js keeps the fetched Python runtime here between builds.
web/.cache/
.env*

# Working TODO: local working document, not tracked.
TODO.md
