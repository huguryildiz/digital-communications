# Third-party and oversized source material. Never redistributed, never in history.
source/

# Generated intermediates and derived editions. Only the artifact and the lecture
# notes PDF are tracked; the other three editions are rebuilt from the sources.
dist/Lecture_Notes.html
dist/Student_Workbook.*
dist/Instructor_Solutions.*
dist/Formula_Reference.*

# Local working area, not student-facing. The commands are tracked: /uret is how
# production is started, so it has to survive a clone.
.claude/*
!.claude/commands/

# Local toolchain and scratch output.
.venv/
node_modules/
shots/
pages/
textclash.json
__pycache__/
.pytest_cache/

.DS_Store
.vercel

# Working notes for the agents that build this, not part of what is published.
AGENTS.md
CLAUDE.md
