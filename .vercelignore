# Nothing here is needed to build the site, and the first entry must never
# leave this machine: `source/` holds the lecture material and a textbook. The
# deploy is a build from `build/src` and `notes/src` by web/build-site.js, so
# excluding these costs nothing. What is served is the assembled `site/`.
source/
.venv/
.claude/
shots/
shots-m/
pages/
site/
web/.cache/
textclash.json
*.tmp
